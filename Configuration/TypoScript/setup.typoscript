plugin.tx_presentationpackage.view {
    templateRootPaths.0 = EXT:presentation_package/Resources/Private/Templates
    partialRootPaths.0 = EXT:presentation_package/Resources/Private/Partials
    layoutRootPaths.0 = EXT:presentation_package/Resources/Private/Layouts
}

# siteKey: Site-Identifier from site configuration
# Used for site specific parts in templates.
[site("identifier") == "subhh-digitalisate"]
    plugin.tx_presentationpackage.settings.siteKey = kulturgut
[site("identifier") == "jungius"]
    plugin.tx_presentationpackage.settings.siteKey = jungius
[END]
    [site("identifier") == "zeitungen"]
plugin.tx_presentationpackage.settings.siteKey = zeitungen
[END]
[site("identifier") == "hoerzu"]
    plugin.tx_presentationpackage.settings.siteKey = hoerzu
[END]
[site("identifier") == "adressbuecher"]
    plugin.tx_presentationpackage.settings.siteKey = adressbuecher
[END]

page.includeCSS {
    presentation = EXT:presentation_package/Resources/Public/Css/kitodoPresentation.css
    searchOverwrite = EXT:presentation_package/Resources/Public/Css/searchOverwrite.css
}

page.includeJSFooter {
    accordion = EXT:presentation_package/Resources/Public/JavaScript/Accordion.js
    kitodoPresentation = EXT:presentation_package/Resources/Public/JavaScript/kitodoPresentation.js
    matomo = EXT:presentation_package/Resources/Public/JavaScript/matomo.js
}

page.shortcutIcon = EXT:presentation_package/Resources/Public/Icons/favicon.ico

plugin.tx_dlf_search {
    view {
        templateRootPaths {
            1 = EXT:presentation_package/Resources/Private/Plugins/Templates/
        }
        partialRootPaths {
            1 = EXT:presentation_package/Resources/Private/Plugins/Partials/
        }
        layoutRootPaths {
            1 = EXT:presentation_package/Resources/Private/Plugins/Layouts/
        }
    }
}

