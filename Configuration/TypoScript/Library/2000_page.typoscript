
# Default PAGE object:
page = PAGE

## Favicon
page.shortcutIcon = {$resDir}/Resources/Public/Icons/favicon_.ico

## CSS Dateien laden
page.includeCSS {
	main = {$resDir}/Resources/Public/Css/main.css
	styles = {$resDir}/Resources/Public/Css/styles.css
}

## JavaScript laden
page.includeJSlibs {
}

page.includeJSFooterlibs {
	#jquery = {$resDir}/Resources/Public/JavaScript/vendor/jquery-1.11.2.min.js
}

page.includeJSFooter {
	jsCookie = {$resDir}/Resources/Public/JavaScript/jsCookie.js
	main = {$resDir}/Resources/Public/JavaScript/main.js
}

## Ersatz fuer das entfernte styles.content.get (css_styled_content):
## Standard-CONTENT-Objekt, das tt_content einer Spalte holt. Das eigentliche
## Rendering der Elemente uebernimmt fluid_styled_content ueber das TS-Objekt "tt_content".
lib.presentationContent = CONTENT
lib.presentationContent {
	table = tt_content
	select {
		orderBy = sorting
		where = colPos = 0
	}
}

page.10 = FLUIDTEMPLATE
page.10 {
	layoutRootPaths {
		10 = {$resDir}/Resources/Private/Layouts
	}
	partialRootPaths {
		10 = {$resDir}/Resources/Private/Partials
	}
	templateRootPaths {
		10 = {$resDir}/Resources/Private/Templates
	}

	dataProcessing {
		# Kollektions-Menu fuer die Startseite (Unterseiten von PID 34) inkl. media-Thumbnail
		10 = TYPO3\CMS\Frontend\DataProcessing\MenuProcessor
		10 {
			special = directory
			special.value = 34
			includeNotInMenu = 1
			as = collectionMenu
			dataProcessing {
				10 = TYPO3\CMS\Frontend\DataProcessing\FilesProcessor
				10 {
					references.fieldName = media
					as = media
				}
			}
		}
		# Breadcrumb / Rootline
		20 = TYPO3\CMS\Frontend\DataProcessing\MenuProcessor
		20 {
			special = rootline
			includeNotInMenu = 1
			as = breadcrumbMenu
		}
	}

	variables {
		contentMain < lib.presentationContent

		contentAside < lib.presentationContent
		contentAside.select.where = colPos = 2
		contentAside.stdWrap {
			wrap = |
			required = 1
		}

		contentHeader < lib.presentationContent
		contentHeader.select.where = colPos = 1
		contentHeader.stdWrap {
			wrap = |
			required = 1
		}

		contentTOC < lib.presentationContent
		contentTOC.select.where = colPos = 3
		contentTOC.stdWrap {
			wrap = |
			required = 1
		}

		contentMetadata < lib.presentationContent
		contentMetadata.select.where = colPos = 4
		contentMetadata.stdWrap {
			wrap = |
			required = 1
		}

		contentTools < lib.presentationContent
		contentTools.select.where = colPos = 5
		contentTools.stdWrap {
			wrap = |
			required = 1
		}

		contentNavigation < lib.presentationContent
		contentNavigation.select.where = colPos = 6
		contentNavigation.stdWrap {
			wrap = |
			required = 1
		}

		contentBasket < lib.presentationContent
		contentBasket.select.where = colPos = 7
		contentBasket.stdWrap {
			wrap = |
			required = 1
		}

		contentMetadataTitle < lib.presentationContent
		contentMetadataTitle.select.where = colPos = 8
		contentMetadataTitle.stdWrap {
			wrap = |
			required = 1
		}

		contentPageviewNavigation < lib.presentationContent
		contentPageviewNavigation.select.where = colPos = 9
		contentPageviewNavigation.stdWrap {
			wrap = |
			required = 1
		}
	}
}

page.10.file.stdWrap.cObject = CASE
page.10.file.stdWrap.cObject {
	key.data = pagelayout

	# Default Template
	default = TEXT
	default.value = {$resDir}/Resources/Private/Templates/DefaultTemplate.html

	pagets__1 < .default

	detail = TEXT
	detail.value = {$resDir}/Resources/Private/Templates/DetailTemplate.html

	pagets__2 < .detail

	onecol = TEXT
	onecol.value = {$resDir}/Resources/Private/Templates/OneColumn.html

	pagets__3 < .onecol

	start = TEXT
	start.value = {$resDir}/Resources/Private/Templates/StartTemplate.html

	pagets__4 < .start

	content = TEXT
	content.value = {$resDir}/Resources/Private/Templates/OneColumnContent.html

	pagets__5 < .content

}
