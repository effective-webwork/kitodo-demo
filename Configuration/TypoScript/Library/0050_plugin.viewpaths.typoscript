## Template-Overrides third-party-Extensions

plugin.tx_dlf.view {
	partialRootPaths {
		0 = EXT:dlf/Resources/Private/Partials
		20 = {$resDir}/Resources/Private/Extensions/Dlf/Partials
	}
	templateRootPaths {
    	0 = EXT:dlf/Resources/Private/Templates
    	20 = {$resDir}/Resources/Private/Extensions/Dlf/Templates
    }
}

## Target element the toolbox renders the ALTO fulltext into.
## dlf ships no default for this: FulltextTool.html always writes the data-dic
## attribute, so the fallback inside FulltextControl.js never applies and
## showFulltext() silently does nothing on an empty value.
plugin.tx_dlf_toolbox.settings.fullTextScrollElement = #tx-dlf-toolbox-fulltext-selection

## Variants of search forms
plugin.tx_dlf_search.settings.searchFormVariant = follow
[page["is_siteroot"] == 1]
	plugin.tx_dlf_search.settings.searchFormVariant = home
[end]
